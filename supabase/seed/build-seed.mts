// Build the starter-recipe seed SQL and the pantry ingredient catalog.
//   node supabase/seed/build-seed.mts <group_id> <author_id>
// Writes supabase/seed/starter-recipes.sql and mobile/src/lib/ingredient-catalog.ts.
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { findRecipeImage } from '../../mobile/src/lib/images.ts';
import { normalizeName, parseIngredientLine } from '../../mobile/src/lib/ingredients.ts';

const here = dirname(fileURLToPath(import.meta.url));
const [groupId, authorId] = process.argv.slice(2);
if (!groupId || !authorId) throw new Error('usage: build-seed.mts <group_id> <author_id>');

const sql = (s: string | null) => (s === null ? 'null' : `'${s.replace(/'/g, "''")}'`);

const recipes = readFileSync(join(here, 'starter-recipes.txt'), 'utf8')
  .split('\n')
  .filter((l) => l.trim() && !l.startsWith('#'))
  .map((line) => {
    const [title, cuisine, serves, minutes, tags, description, ingredients, steps] = line.split('|').map((s) => s.trim());
    return {
      title,
      cuisine,
      servings: Number(serves),
      minutes: Number(minutes),
      tags: tags ? tags.split(',').map((t) => t.trim()).filter(Boolean) : [],
      description,
      ingredients: ingredients.split(';').map((i) => parseIngredientLine(i)!).filter(Boolean),
      steps: steps.split(';').map((s) => s.trim()).filter(Boolean),
    };
  });

console.log(`${recipes.length} recipes`);

const rows: string[] = [];
let withImage = 0;
for (const r of recipes) {
  // Be polite to Wikipedia's API: one lookup per second.
  await new Promise((done) => setTimeout(done, 1000));
  const image = await findRecipeImage(r.title);
  if (image) withImage++;
  else console.log(`  no image: ${r.title}`);
  rows.push(
    `(${sql(groupId)}, ${sql(authorId)}, ${sql(r.title)}, ${sql(`${r.description} (${r.cuisine})`)}, ${r.servings}, ${r.minutes}, ` +
      `${sql(JSON.stringify(r.ingredients))}::jsonb, ARRAY[${r.steps.map(sql).join(', ')}]::text[], ` +
      `ARRAY[${r.tags.map(sql).join(', ')}]::text[], ${sql(image)})`,
  );
}
console.log(`${withImage}/${recipes.length} with images`);

writeFileSync(
  join(here, 'starter-recipes.sql'),
  `-- Generated by build-seed.mts: ${recipes.length} starter recipes.\n` +
    `insert into public.recipes (group_id, author_id, title, description, servings, total_minutes, ingredients, steps, dietary_tags, image_url)\nvalues\n` +
    rows.join(',\n') +
    ';\n',
);

// Pantry catalog: every ingredient used, plus common extras.
const EXTRAS = [
  'apples', 'bananas', 'oranges', 'lemons', 'limes', 'grapes', 'strawberries', 'blueberries', 'peaches', 'pears', 'watermelon',
  'spinach', 'kale', 'cabbage', 'broccoli', 'cauliflower', 'zucchini', 'eggplant', 'sweet potatoes', 'potatoes', 'mushrooms',
  'chicken breast', 'chicken thighs', 'ground beef', 'ground turkey', 'pork chops', 'bacon', 'ham', 'sausages', 'salmon', 'tuna', 'shrimp', 'tofu',
  'milk', 'butter', 'yogurt', 'cheddar cheese', 'mozzarella', 'parmesan cheese', 'cream cheese', 'sour cream', 'heavy cream', 'eggs',
  'bread', 'tortillas', 'pasta', 'rice', 'oats', 'flour', 'sugar', 'brown sugar', 'honey', 'peanut butter', 'jam', 'cereal', 'crackers',
  'olive oil', 'vegetable oil', 'salt', 'black pepper', 'garlic powder', 'onion powder', 'chili flakes', 'soy sauce', 'ketchup', 'mustard', 'mayonnaise', 'vinegar',
  'canned tomatoes', 'canned beans', 'chicken broth', 'vegetable broth', 'coffee', 'tea',
];
const seen = new Map<string, string>();
for (const name of [...recipes.flatMap((r) => r.ingredients.map((i) => i.name.split(',')[0].trim().toLowerCase())), ...EXTRAS]) {
  const key = normalizeName(name);
  if (key && !seen.has(key)) seen.set(key, name);
}
const catalog = [...seen.values()].sort((a, b) => a.localeCompare(b));
writeFileSync(
  join(here, '../../mobile/src/lib/ingredient-catalog.ts'),
  `// Generated by supabase/seed/build-seed.mts from the starter recipes plus common staples.\n` +
    `export const INGREDIENT_CATALOG: string[] = ${JSON.stringify(catalog, null, 2)};\n`,
);
console.log(`${catalog.length} catalog ingredients`);
